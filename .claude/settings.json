{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm preview)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm lint:house)",
      "Bash(pnpm check:seo)",
      "Bash(pnpm build:check)",
      "Bash(pnpm placeholders)",
      "Bash(pnpm astro:*)",
      "Bash(pnpm exec astro:*)",
      "Bash(node scripts/:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)"
    ]
  }
}
