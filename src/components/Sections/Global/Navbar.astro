---
// src/components/Sections/Global/Navbar.astro - la barre flottante : marque, cinq rubriques, selecteur de langue, tiroir mobile et etat retracte au scroll.
//
// Le menu mobile est le tiroir natif de Reef (<dialog>, voir ui/sheet) : il
// se ferme a la touche Echap, au clic sur le fond, a la croix et, ajoute ici
// (voir ./_navbar.ts), au clic sur l'un de ses liens. Aucun framework.
//
// data-shrunk est pose par ./_navbar.ts et lu par deux endroits : le CSS
// local (la pilule se resserre), et materials.css, dont la regle
// [data-header][data-shrunk="true"]::after degrade le contenu la ou la barre le
// recouvre vraiment. Renommer cet attribut casse le fondu de bord.
import { Icon } from "@components/svg/icons";
import { LocaleSwitcher } from "@components/ui/locale-switcher";
import { Sheet, SheetClose, SheetHeader, SheetTitle, SheetTrigger } from "@components/ui/sheet";
import { getLocale, sectionKeys, sectionPath, useTranslations, type SectionKey, type Translations } from "@i18n";

interface Props {
  /** L'adresse de la page dans chaque langue, pour le selecteur de langue. */
  translations: Translations;
  /** La rubrique a laquelle appartient la page en cours. */
  current?: SectionKey | undefined;
}

const { translations, current } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);

const links = sectionKeys.map((key) => ({ key, href: sectionPath(key, locale), text: t.nav[key] }));
const homeHref = sectionPath("home", locale);

// aria-current="page" sur la page exacte ; "true" sur la rubrique dont la page
// en cours fait partie (une activite allume "Activites" sans la declarer page).
const ariaCurrent = (key: SectionKey, href: string): "page" | "true" | undefined => {
  if (Astro.url.pathname === href) return "page";
  return key === current ? "true" : undefined;
};

// Lien de nav : il herite de la couleur de la barre au lieu de la fixer, ce qui
// le laisse lisible sur le verre clair comme sur le verre sombre du hero.
// Aucune classe d'affichage dans cette chaine partagee : un "hidden lg:flex"
// pose par l'appelant perdrait contre le "inline-flex" de la chaine.
const navLink = [
  "min-h-11 items-center rounded-pill px-3.5",
  "font-sans text-[0.9rem] font-medium whitespace-nowrap text-current",
  "transition-colors duration-200 hover:bg-current/8",
].join(" ");
---

{/* Le lien d'evitement est le premier element focalisable du document. Il ne
    se voit qu'au clavier, ou il est la premiere chose dont on a besoin. */}
<a
  href="#content"
  class="bg-primary text-primary-foreground font-display sr-only rounded-pill px-5 py-3 text-sm font-bold focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-100"
>
  {t.common.skipToContent}
</a>

{/* Pas de transition:persist : la barre porte la page courante et le selecteur de
    langue, qui doivent suivre chaque navigation. */}
{/* Le decalage du haut vit dans le bloc <style is:global> plus bas, en
    regles [data-header]{top:...}, et NULLE PART ailleurs : un utilitaire
    Tailwind de top ici battrait la regle globale et collerait la pilule au bord
    de la fenetre. Les trois paliers suivent le cadre p-2 / p-3 / p-4 du hero. */}
<header class="fixed inset-x-0 z-50" data-header>
  <div class="container-page" data-header-track>
    <nav
      class="glass-light text-foreground rounded-pill flex items-center gap-2 py-2.5 pr-2.5 pl-5"
      aria-label={t.nav.mainLabel}
      data-navbar
    >
      <a
        href={homeHref}
        class="flex min-h-11 shrink-0 items-center gap-2 text-current"
        aria-label={t.nav.brandHome}
        data-header-brand
      >
        <Icon name="wave" size={20} class="text-primary" />
        <span class="font-display text-lg font-semibold tracking-tight">{t.site.name}</span>
      </a>

      <ul class="mx-auto hidden items-center gap-0.5 lg:flex">
        {
          links.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["inline-flex", navLink, ariaCurrent(item.key, item.href) && "bg-current/8 font-semibold"]}
                aria-current={ariaCurrent(item.key, item.href)}
              >
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="ml-auto flex items-center gap-1 lg:ml-0">
        <LocaleSwitcher translations={translations} class="max-sm:hidden" />
        <SheetTrigger
          for="mobile-nav"
          variant="ghost"
          size="icon"
          class="text-current hover:bg-current/8 lg:hidden"
          aria-label={t.nav.openMenu}
        >
          <Icon name="menu" size={21} />
        </SheetTrigger>
      </div>
    </nav>
  </div>
</header>

{/* Le tiroir : le meme <dialog> natif que Dialog, dont le geste de fermeture
    est deja branche par la primitive. */}
<Sheet id="mobile-nav" side="right" describedby={null}>
  <SheetClose label={t.nav.closeMenu} />
  <SheetHeader>
    <SheetTitle id="mobile-nav-title" class="flex items-center gap-2">
      <Icon name="wave" size={20} class="text-primary" />
      {t.nav.menuTitle}
    </SheetTitle>
  </SheetHeader>

  <nav aria-label={t.nav.mobileLabel}>
    <ul class="flex flex-col">
      {
        links.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "font-display text-foreground hover:bg-muted rounded-card flex min-h-12 items-center px-3 text-lg font-semibold",
                ariaCurrent(item.key, item.href) && "bg-muted",
              ]}
              aria-current={ariaCurrent(item.key, item.href)}
            >
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {/* Sur mobile le selecteur vit dans le tiroir : la barre garde sa place pour la marque et le menu. */}
  <div class="mt-auto sm:hidden">
    <LocaleSwitcher translations={translations} variant="inline" />
  </div>
</Sheet>

<script>
  // Le comportement vit dans ./_navbar.ts : limite de 400 lignes par fichier, et le
  // precede de ui/_dialog.ts pour tout comportement non trivial.
  import "./_navbar";
</script>

<style is:global>
  /* --- Barre retractable ---------------------------------------------------
   * En haut de page : pleine largeur du conteneur, respiration genereuse. Des
   * que le visiteur descend : la piste se resserre, la pilule se compacte et se
   * rapproche du bord. Une seule courbe pour les trois, pour que le mouvement
   * se lise comme un seul geste et non comme trois animations concurrentes. */
  /* --- Le jeu entre la barre et le cadre -----------------------------------
   * La scene du hero est posee dans un cadre arrondi qui laisse une marge de
   * 0.5rem a 1rem contre le bord de la fenetre. La barre descend d'un cran de
   * plus que le cadre a chaque borne, ce qui laisse toujours un jeu visible
   * entre les deux. L'encoche l'emporte toujours : env() reste dans le max().
   *
   * NE PAS deplacer ces valeurs dans la classe du <header> : un utilitaire
   * Tailwind [top:...] bat ces regles, fige les trois paliers a une seule
   * valeur, et la pilule repasse au-dessus du coin arrondi du cadre. */
  [data-header] {
    top: max(1.25rem, env(safe-area-inset-top));
  }

  @media (min-width: 40rem) {
    [data-header] {
      top: max(1.5rem, env(safe-area-inset-top));
    }
  }

  @media (min-width: 48rem) {
    [data-header] {
      top: max(1.75rem, env(safe-area-inset-top));
    }
  }

  [data-header] {
    transition: top 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  [data-header][data-shrunk="true"] {
    top: max(0.375rem, env(safe-area-inset-top));
  }

  [data-header-track] {
    transition: max-width 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* La largeur resserree est MESUREE, pas choisie : --header-compact est pose
   * par _navbar.ts, apres avoir demande au navigateur la place que prend
   * reellement le contenu de la barre. Le repli 100% est volontaire : si le
   * script ne tourne pas, la barre garde sa largeur pleine et ne perd que son
   * mouvement, au lieu de laisser ses boutons deborder du verre. */
  [data-header][data-shrunk="true"] [data-header-track] {
    max-width: min(100%, var(--header-compact, 100%));
  }

  /* Le temps d'une mesure, aucune transition : sinon on mesure une image
   * intermediaire de l'animation et la barre se fige a la mauvaise largeur. */
  [data-header][data-measuring],
  [data-header][data-measuring] * {
    transition: none !important;
  }

  [data-navbar] {
    transition:
      padding 420ms cubic-bezier(0.22, 0.61, 0.36, 1),
      background-color 300ms,
      border-color 300ms,
      box-shadow 300ms,
      color 300ms;
  }

  [data-header][data-shrunk="true"] [data-navbar] {
    padding-block: 0.3125rem;
    padding-left: 0.875rem;
    padding-right: 0.375rem;
  }

  /* Le mot-marque suit le mouvement, discretement. */
  [data-header-brand] span {
    transition: font-size 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  [data-header][data-shrunk="true"] [data-header-brand] span {
    font-size: 1rem;
  }

  /* Personne ne doit subir ce mouvement s'il a demande le calme. */
  @media (prefers-reduced-motion: reduce) {
    [data-header],
    [data-header-track],
    [data-navbar],
    [data-header-brand] span {
      transition: none;
    }
  }
</style>
